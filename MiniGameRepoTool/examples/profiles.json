          "branch": "",
          "enabled": true,
          "depends_on": []
        },
        {
          "id": "assets",
          "name": "AssetRuntime",
          "path": "AssetRuntime",
          "remote": "git@client-gitlab.miniworldplus.com:miniwan/assetruntimenew.git",
          "branch_group": "game",
          "branch": "",
          "enabled": true,
          "depends_on": []
        },
        {
          "id": "common",
          "name": "CommonResource",
          "path": "AssetRuntime/CommonResource",
          "remote": "git@client-gitlab.miniworldplus.com:miniwan/CommonResource.git",
          "branch_group": "game",
          "branch": "",
          "enabled": true,
          "depends_on": []
        },
        {
          "id": "source",
          "name": "Source",
          "path": "Source",
          "remote": "git@client-gitlab.miniworldplus.com:miniwan/MiniGameCode.git",
          "branch_group": "game",
          "branch": "",
          "enabled": true,
          "depends_on": []
        },
        {
          "id": "sandbox",
          "name": "SandboxEngine",
          "path": "Source/SandboxEngine",
          "remote": "git@yw-gitlab.miniworldplus.com:minitech/sandboxengine.git",
          "branch_group": "game",
          "branch": "",
          "enabled": true,
          "depends_on": []
        },
        {
          "id": "aigameplay",
          "name": "AIGamePlay",
          "path": "Source/AIGamePlay",
          "remote": "git@yw-gitlab.miniworldplus.com:engine/aigameplay.git",
          "branch_group": "game",
          "branch": "",
          "enabled": true,
          "depends_on": []
        },
        {
          "id": "rainbow",
          "name": "RainbowEngine",
          "path": "Source/Core/RainbowEngine",
          "remote": "git@yw-gitlab.miniworldplus.com:minitech/engine.git",
          "branch_group": "engine",
          "branch": "",
          "enabled": true,
          "depends_on": []
        },
        {
          "id": "editor",
          "name": "Editor",
          "path": "Source/Editor",
          "remote": "git@yw-gitlab.miniworldplus.com:minitech/editor.git",
          "branch_group": "engine",
          "branch": "",
          "enabled": true,
          "depends_on": []
        }
      ],
      "build": {
        "steps": ["compile"],
        "python_path": "Tools/buildtools/Python39/python.exe",
        "generation_tasks": [
          {
            "id": "generate-game",
            "bat": "SetupScript/Win_MiniGame_GenerateProject.bat",
            "arguments": [],
            "build_directory": "",
            "enabled": true
          },
          {
            "id": "generate-ai",
            "bat": "SetupScript/Win_AICore_GenerateProject.bat",
            "arguments": [],
            "build_directory": "",
            "enabled": true
          }
        ],
        "compile_tasks": [
          {
            "id": "compile-game",
            "generation_id": "generate-game",
            "solution": "Projects/vs2019-win64-MiniGame/MiniGame.sln",
            "target": "MiniGameApp",
            "configuration": "Debug",
            "platform": "x64",
            "action": "Build",
            "enabled": true
          },
          {
            "id": "compile-ai",
            "generation_id": "generate-ai",
            "solution": "Projects/vs2019-win64-AICore/AICore.sln",
            "target": "AICore",
            "configuration": "Debug",
            "platform": "x64",
            "action": "Build",
            "enabled": true
          }
        ],
        "ib_skill_dir": "D:/git/skills/mini-compile-ib"
      },
      "setup": {
        "auto_run": false,
        "required_repositories": [
          "main",
          "assets",
          "common",
          "source",
          "sandbox",
          "aigameplay",
          "rainbow",
          "editor"
        ]
      },
      "init": {
        "mode": "auto",
        "sources": [
          "D:/MiniGame",
          "D:/AIMiniGame",
          "D:/MiniGameProfiler"
        ],
        "reuse_git": true,
        "reuse_lfs": true,
        "fallback": true
      }
    }
  ]
}
